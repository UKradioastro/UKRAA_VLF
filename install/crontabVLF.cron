# UKRAA VLF crontab entries
#
# NOTE: the Pi should have its timezone set to UTC so cron times match the
# UTC timestamps used in all data and log files.
#
# Paths assume the installation lives in /home/pi/UKRAA-VLF - adjust if
# installed elsewhere.

# ------------------------------------------------------------------------------------------
# Data collection
# ------------------------------------------------------------------------------------------

# cron entry to fetch NOAA GOES primary X-ray flux data and X-ray flare
# events (run consecutively so logfile entries stay sequential) every 5 minutes
*/5 * * * * /bin/bash /home/pi/UKRAA-VLF/scripts/getDataNOAA.sh >> /home/pi/UKRAA-VLF/logfiles/logerror.log 2>&1

# cron entry to fetch sunrise/sunset times for the day - hourly at :03 UTC
# (exits immediately if the day's file already exists, so this normally runs
# the API fetch once just after midnight; the later runs are free retries
# after a network outage)
03 * * * * /usr/bin/python3 /home/pi/UKRAA-VLF/scripts/GetDataSun.py >> /home/pi/UKRAA-VLF/logfiles/logerror.log 2>&1

# ------------------------------------------------------------------------------------------
# Housekeeping
# ------------------------------------------------------------------------------------------

# NOTE: VLF aerial capture (GetDataAerial.py) is NOT run from cron - it runs
# as a systemd service that restarts automatically on failure.
# See install/ukraa-vlf-aerial.service.

# cron entry to check aerial data is still arriving and not all-nan
# (alert-only to logerror.log; recovery is handled by systemd) - every 10 minutes
7-59/10 * * * * /usr/bin/python3 /home/pi/UKRAA-VLF/scripts/CheckDataAerial.py >> /home/pi/UKRAA-VLF/logfiles/logerror.log 2>&1

# cron entry to manage (rotate/trim) logfiles - Sunday 00:30 each week
30 00 * * 00 /bin/bash /home/pi/UKRAA-VLF/scripts/manageLogfiles.sh >> /home/pi/UKRAA-VLF/logfiles/logerror.log 2>&1

# ------------------------------------------------------------------------------------------
# Plotting
# ------------------------------------------------------------------------------------------

# cron entry to refresh the rolling 24-hour plots (VLF + X-ray) every 5 minutes,
# offset 2 minutes after the data fetches
2-59/5 * * * * /usr/bin/python3 /home/pi/UKRAA-VLF/scripts/PlotDataRolling.py >> /home/pi/UKRAA-VLF/logfiles/logerror.log 2>&1

# cron entries to refresh the rolling 3-day and 7-day plots (only produced
# when enabled in config/plots.ini) - hourly, at minutes clear of the
# 5-minute jobs to spread the load
16 * * * * /usr/bin/python3 /home/pi/UKRAA-VLF/scripts/PlotDataRolling.py --days 3 >> /home/pi/UKRAA-VLF/logfiles/logerror.log 2>&1
46 * * * * /usr/bin/python3 /home/pi/UKRAA-VLF/scripts/PlotDataRolling.py --days 7 >> /home/pi/UKRAA-VLF/logfiles/logerror.log 2>&1

# cron entry to create yesterday's plots (VLF SID + X-ray) - daily at 00:20 UTC
20 00 * * * /usr/bin/python3 /home/pi/UKRAA-VLF/scripts/PlotDataYesterday.py >> /home/pi/UKRAA-VLF/logfiles/logerror.log 2>&1

# cron entries to create the static (midnight-aligned) 3-day and 7-day plots
# (only produced when enabled in config/plots.ini) - daily after the
# yesterday plots, at minutes clear of the 5-minute jobs
24 00 * * * /usr/bin/python3 /home/pi/UKRAA-VLF/scripts/PlotDataPeriod.py --days 3 >> /home/pi/UKRAA-VLF/logfiles/logerror.log 2>&1
34 00 * * * /usr/bin/python3 /home/pi/UKRAA-VLF/scripts/PlotDataPeriod.py --days 7 >> /home/pi/UKRAA-VLF/logfiles/logerror.log 2>&1

# ------------------------------------------------------------------------------------------
# Alerting
# ------------------------------------------------------------------------------------------

# cron entry to evaluate X-ray flare email alerts and the daily heartbeat
# (see config/alerts.ini) every 5 minutes, offset after the data fetches
# and the rolling plots so emails use the latest data and plot
3-59/5 * * * * /usr/bin/python3 /home/pi/UKRAA-VLF/scripts/EvaluateAlerts.py >> /home/pi/UKRAA-VLF/logfiles/logerror.log 2>&1

# ------------------------------------------------------------------------------------------
# Publishing
# ------------------------------------------------------------------------------------------

# cron entry to upload plots and web assets to WWW - daily at 00:45 UTC
#45 00 * * * /bin/bash /home/pi/UKRAA-VLF/scripts/uploadWWW.sh >> /home/pi/UKRAA-VLF/logfiles/logerror.log 2>&1
