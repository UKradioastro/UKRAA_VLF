; UKRAA VLF plot configuration
; Copy to /home/pi/UKRAA-VLF/config/plots.ini and adjust as required.
;
; One section per plot type. If this file (or a key) is missing the
; defaults shown below are used, which match the original behaviour:
; rolling and yesterday plots with all overlays, no 3/7-day plots.
;
; Keys (all true/false):
;   enabled : produce this plot at all
;   sun     : sunrise/sunset shading and marks (one night band per day -
;             busy on the multi-day plots, which default to false)
;   xray    : NOAA GOES X-ray flux overlay (red, right-hand axis)
;   flares  : solar flare begin/end markers with class labels (a week of
;             C-class markers swamps the 7-day plot, so it defaults off)
;
; Each section may also set (a GOES class string, not true/false):
;   min_flare_class : only mark flares whose peak reaches this class,
;             e.g. C1.0 hides the B-class markers that make an active
;             day busy. Leave empty (or omit) to mark every flare, the
;             original behaviour. Applies to the markers only - flare
;             alert emails (alerts.ini) and SID event detection
;             (baa-report.ini) have their own thresholds.
;
; Notes:
;   - The 3day and 7day sections each control two plots: the rolling
;     3/7-day plot (refreshed hourly) and the static complete-days
;     3/7-day plot (midnight to midnight, refreshed daily) - see
;     crontabVLF.cron. Both appear automatically on the web page when
;     enabled.
;   - The transmitter off-air annotation is only drawn on the rolling
;     and yesterday plots.

[rolling]
enabled = true
sun = true
xray = true
flares = true
min_flare_class =

[yesterday]
enabled = true
sun = true
xray = true
flares = true
min_flare_class =

[3day]
enabled = false
sun = false
xray = true
flares = true
min_flare_class =

[7day]
enabled = false
sun = false
xray = true
flares = false
min_flare_class =
