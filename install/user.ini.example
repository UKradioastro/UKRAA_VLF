; UKRAA VLF user configuration file
; Copy to /home/pi/UKRAA-VLF/config/user.ini and adjust for your station.
;
; latitude/longitude are in decimal degrees (south/west negative) and are
; used to fetch sunrise/sunset times from https://sunrise-sunset.org
;
; Note: North = +ve and South = -ve
;       East = +ve and west = -ve

[location]
name = your_location e.g. London
latitude = xx.xxxxx
longitude = xx.xxxxx
